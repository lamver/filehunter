{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileHunter",
  "version": "0.1.3",
  "identifier": "ai.rechka.filecat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FileHunter",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Valerij Frolov",
    "copyright": "© 2026 Valerij Frolov",
    "category": "Utility",
    "shortDescription": "Файлы всех дисков, облаков и компьютеров в одном окне",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQjJEMzY4QjRCOTVEMzcKUldRM1hibTBhTk95d1RPdFQ1VXRjOEpRNGJXQ0pIR2h0UU9nUmdmSjE5R09kZGs0ci9weXN6VWUK",
      "endpoints": ["https://github.com/lamver/filehunter/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
